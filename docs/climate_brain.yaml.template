template:
  - sensor:
      - name: Climate Brain period
        unique_id: climate_brain_period
        icon: mdi:clock-outline
        state: >-
          {% set occupied = is_state('__OCCUPANCY__', 'on') %}
          {% set debounce = is_state('timer.climate_brain_away_debounce', 'active') %}
          {% set precool_on = is_state('timer.climate_brain_precool_safety', 'active') %}
          {% if is_state('input_boolean.climate_brain_vacation', 'on') %}
            vacation
          {% elif is_state('timer.climate_brain_vacation_boost', 'active') %}
            vacation_boost
          {% elif precool_on and not (occupied or debounce) %}
            precool
          {% elif not (occupied or debounce) %}
            empty
          {% elif is_state('timer.climate_brain_late_arrival', 'active') %}
            late_hold
          {% else %}
            {% set hm = now().hour * 60 + now().minute %}
            {% set ns = states('input_datetime.climate_brain_night_start') %}
            {% set z2 = states('input_datetime.climate_brain_morning_z2') %}
            {% set z1 = states('input_datetime.climate_brain_morning_z1') %}
            {% set day = states('input_datetime.climate_brain_day_start') %}
            {% set night_hm = ns[0:2] | int(22) * 60 + ns[3:5] | int(30) %}
            {% set z2_hm = z2[0:2] | int(5) * 60 + z2[3:5] | int(15) %}
            {% set z1_hm = z1[0:2] | int(5) * 60 + z1[3:5] | int(45) %}
            {% set day_hm = day[0:2] | int(6) * 60 + day[3:5] | int(15) %}
            {% if hm >= night_hm or hm < z2_hm %}
              night
            {% elif hm < z1_hm %}
              morning_z2
            {% elif hm < day_hm %}
              morning_z1
            {% else %}
              day
            {% endif %}
          {% endif %}
      - name: Climate Brain outdoor
        unique_id: climate_brain_outdoor
        unit_of_measurement: "°F"
        device_class: temperature
        state: >-
          {% set e = '__OUTDOOR__' %}
          {% if e.startswith('weather.') %}
            {{ state_attr(e, 'temperature') | float(none) }}
          {% else %}
            {{ states(e) | float(none) }}
          {% endif %}
      - name: Zone 2 humidity average
        unique_id: climate_brain_z2_humidity
        unit_of_measurement: "%"
        device_class: humidity
        state: >-
          {% set a = states('__HUMIDITY_A__') | float(none) %}
          {% set b = states('__HUMIDITY_B__') | float(none) %}
          {% if a is number and b is number %}
            {{ ((a + b) / 2) | round(1) }}
          {% elif a is number %}
            {{ a }}
          {% elif b is number %}
            {{ b }}
          {% else %}
            unknown
          {% endif %}
__TESLA_DIRECTION_SENSORS__
      - name: Climate Brain family eta
        unique_id: climate_brain_family_eta
        unit_of_measurement: min
        icon: mdi:map-clock
        state: >-
          {% set phones = [__PEOPLE_ETA_PAIRS__] %}
          {% set ns = namespace(best=9999) %}
          {% for dir_e, eta_e in phones %}
            {% set d = states(dir_e) | lower %}
            {% set toward = ('toward' in d) and ('inhome' not in d) and ('instat' not in d) %}
            {% if toward %}
              {% set raw = states(eta_e) | string | lower %}
              {% set mins = 0 %}
              {% if raw not in ['unknown', 'unavailable', 'none', ''] %}
                {% if ':' in raw %}
                  {% set pp = raw.split(':') %}
                  {% set hp = pp[0] | regex_findall('\\d+') %}
                  {% set mp = pp[1] | regex_findall('\\d+') if pp | count > 1 else [] %}
                  {% set mins = (hp[0] | int(0) if hp else 0) * 60 + (mp[0] | int(0) if mp else 0) %}
                {% else %}
                  {% set hm = raw | regex_findall('(\\d+)\\s*(?:h|hr|hrs|hour|hours)') %}
                  {% set mm = raw | regex_findall('(\\d+)\\s*(?:m|min|mins|minute|minutes)') %}
                  {% if hm or mm %}
                    {% set mins = (hm[0] | int(0) if hm else 0) * 60 + (mm[0] | int(0) if mm else 0) %}
                  {% else %}
                    {% set nums = raw | regex_findall('\\d+') %}
                    {% set mins = nums[0] | int(0) if nums else 0 %}
                  {% endif %}
                {% endif %}
              {% endif %}
              {% if mins > 0 and mins < ns.best %}
                {% set ns.best = mins %}
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if ns.best < 9999 %}
            {{ ns.best }}
          {% else %}
            unknown
          {% endif %}

script:
  climate_brain_vacation_boost_start:
    alias: Climate Brain vacation Boost start
    description: Boost both Trane zones until Comfort, or skip if already in band.
    mode: restart
    sequence:
      - variables:
          z1t: "{{ state_attr('__Z1__', 'current_temperature') | float(none) }}"
          z2t: "{{ state_attr('__Z2__', 'current_temperature') | float(none) }}"
          h1: "{{ states('input_number.climate_brain_comfort_heat') | float(71) }}"
          c1: "{{ states('input_number.climate_brain_comfort_cool') | float(74) }}"
          z1n: "{{ z1t if z1t is number else h1 }}"
          z2n: "{{ z2t if z2t is number else h1 }}"
          heat_need: "{{ [h1 - z1n, h1 - z2n] | max }}"
          cool_need: "{{ [z1n - c1, z2n - c1] | max }}"
          in_band: "{{ (heat_need | float(0)) <= 0.5 and (cool_need | float(0)) <= 0.5 }}"
          start: "{{ ((z1n | float(71)) + (z2n | float(71))) / 2 }}"
      - action: input_number.set_value
        target:
          entity_id: input_number.climate_brain_vacation_start_temp
        data:
          value: "{{ start }}"
      - if:
          - condition: template
            value_template: "{{ in_band | bool }}"
        then:
          - action: timer.cancel
            target:
              entity_id: timer.climate_brain_vacation_boost
          - stop: already in Comfort band
            error: false
      - action: timer.cancel
        target:
          entity_id:
            - timer.climate_brain_late_arrival
            - timer.climate_brain_precool_safety
            - timer.climate_brain_morning_boost
      - action: timer.start
        target:
          entity_id: timer.climate_brain_vacation_boost
        data:
          duration: "02:00:00"

  climate_brain_write_zone:
    alias: Climate Brain write zone
    description: Sole Trane writer for one zone. Skip if already at want HVAC and temps within 0.4F.
    mode: queued
    max: 8
    fields:
      climate_entity:
        required: true
        selector:
          entity:
            domain: climate
      hvac_mode:
        required: true
        selector:
          text:
      kind:
        selector:
          text:
      temperature:
        selector:
          number:
      target_temp_low:
        selector:
          number:
      target_temp_high:
        selector:
          number:
    sequence:
      - if:
          - condition: template
            value_template: "{{ not climate_entity }}"
        then:
          - stop: missing climate
            error: false
      - if:
          - condition: template
            value_template: "{{ states(climate_entity) in ['unknown', 'unavailable', 'none', ''] }}"
        then:
          - stop: climate unavailable
            error: false
      - variables:
          cur_hvac: "{{ states(climate_entity) | lower }}"
          raw_hvac: "{{ hvac_mode | lower }}"
          want_hvac: "{{ 'heat_cool' if raw_hvac in ['auto', 'heat_cool'] else raw_hvac }}"
          want_kind: "{{ kind | default('none') | lower }}"
          raw_lo: "{{ target_temp_low | float(71) }}"
          raw_hi: "{{ target_temp_high | float(74) }}"
          want_lo: "{{ raw_lo | float(71) }}"
          want_hi: >-
            {% set lo = raw_lo | float(71) %}
            {% set hi = raw_hi | float(74) %}
            {{ hi if lo < hi else lo + 3 }}
          want_temp: "{{ temperature | float(72) }}"
          same_hvac: "{{ cur_hvac == want_hvac }}"
          same_temps: >-
            {% if want_hvac in ['heat', 'cool'] or want_kind == 'single' %}
              {% set t = state_attr(climate_entity, 'temperature') | float(none) %}
              {{ t is number and (t - want_temp | float(0)) | abs <= 0.4 }}
            {% else %}
              {% set lo = state_attr(climate_entity, 'target_temp_low') | float(none) %}
              {% set hi = state_attr(climate_entity, 'target_temp_high') | float(none) %}
              {{ lo is number and hi is number
                 and (lo - want_lo | float(0)) | abs <= 0.4
                 and (hi - want_hi | float(0)) | abs <= 0.4 }}
            {% endif %}
      - if:
          - condition: template
            value_template: "{{ (same_hvac | bool) and (same_temps | bool) }}"
        then:
          - stop: already at wanted HVAC and temps
            error: false
      - if:
          - condition: template
            value_template: "{{ want_hvac not in ['heat', 'cool', 'heat_cool', 'off'] }}"
        then:
          - stop: refused HVAC mode (never auto)
            error: false
      - if:
          - condition: template
            value_template: "{{ not (same_hvac | bool) }}"
        then:
          - action: climate.set_hvac_mode
            continue_on_error: true
            target:
              entity_id: "{{ climate_entity }}"
            data:
              hvac_mode: "{{ want_hvac }}"
      - if:
          - condition: template
            value_template: "{{ want_hvac in ['heat', 'cool'] or want_kind == 'single' }}"
        then:
          - if:
              - condition: template
                value_template: "{{ (not (same_hvac | bool)) or (not (same_temps | bool)) }}"
            then:
              - action: climate.set_temperature
                continue_on_error: true
                target:
                  entity_id: "{{ climate_entity }}"
                data:
                  temperature: "{{ want_temp | float }}"
      - if:
          - condition: template
            value_template: "{{ want_hvac == 'heat_cool' and want_kind != 'single' }}"
        then:
          - if:
              - condition: template
                value_template: "{{ (not (same_hvac | bool)) or (not (same_temps | bool)) }}"
            then:
              - action: climate.set_temperature
                continue_on_error: true
                target:
                  entity_id: "{{ climate_entity }}"
                data:
                  target_temp_low: "{{ want_lo | float }}"
                  target_temp_high: "{{ want_hi | float }}"


